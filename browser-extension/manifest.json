{
  "manifest_version": 3,
  "name": "Kibana Dashboard Builder",
  "version": "1.0.0",
  "description": "Live YAML editor for Kibana dashboards with decompile support",
  
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  
  "host_permissions": [
    "http://localhost/*",
    "https://*/*"
  ],
  
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  
  "action": {
    "default_title": "Open Dashboard Builder",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "content_scripts": [
    {
      "matches": [
        "*://*/app/dashboards*",
        "*://*/app/kibana*",
        "*://*/app/management*",
        "*://*/app/discover*",
        "*://*/app/visualize*",
        "*://*/app/canvas*"
      ],
      "js": ["lib/js-yaml.min.js", "content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "lib/pyodide/*",
        "lib/pyodide/**/*",
        "lib/monaco-editor/**/*",
        "python/**/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  
  "background": {
    "service_worker": "background/service-worker.js"
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
